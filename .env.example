# STT Configuration: groq | sarvam | local_whisper | deepgram
STT_PROVIDER=deepgram

# Parser Configuration: groq | gemini | local_rules
PARSER_PROVIDER=gemini

# Enable automatic failover on 429/5xx errors
ENABLE_FAILOVER=true

# API Keys
GROQ_API_KEY=
SARVAM_API_KEY=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=

# Local Whisper Model Size: tiny, base, small, medium
LOCAL_WHISPER_SIZE=base

# Application Settings
DATABASE_PATH=reminders.db
HOST=0.0.0.0
PORT=8000

